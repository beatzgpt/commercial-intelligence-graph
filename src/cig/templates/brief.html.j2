<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Account brief: {{ p.company.name }}</title>
<style>
  :root { --ink:#1b1f24; --muted:#5b6573; --line:#e3e7ec; --accent:#1f3a5f; --bg:#f6f8fa; --good:#2a9d8f; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif; color:var(--ink); background:var(--bg); }
  main { max-width:920px; margin:0 auto; padding:32px 16px 48px; }
  .badge { display:inline-block; font-size:12px; color:var(--muted); border:1px solid var(--line); background:#fff; border-radius:999px; padding:2px 10px; }
  h1 { margin:10px 0 4px; font-size:26px; color:var(--accent); }
  h2 { margin:28px 0 8px; font-size:15px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px 18px; }
  .meta { color:var(--muted); margin:0 0 14px; }
  .score { font-size:34px; font-weight:700; color:var(--accent); }
  .score small { font-size:14px; font-weight:400; color:var(--muted); }
  table { width:100%; border-collapse:collapse; font-size:13.5px; }
  th, td { text-align:left; padding:7px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-weight:600; }
  td.num { text-align:right; font-variant-numeric:tabular-nums; }
  tfoot td { font-weight:700; border-bottom:0; }
  .tag { font-size:11px; padding:1px 7px; border-radius:999px; background:#eef2f6; color:var(--accent); }
  .legacy { background:#fbeaea; color:#a02a1e; } .modern { background:#e6f1fb; color:#1c5f9a; }
  code { font-size:12px; color:var(--muted); }
  @media (max-width:640px) { table { font-size:12.5px; } .hide-sm { display:none; } }
</style>
</head>
<body>
<main>
  <span class="badge">Synthetic data | as of {{ p.as_of }} | narrative: {{ n.mode }}</span>
  <h1>{{ p.company.name }}</h1>
  <p class="meta">{{ p.company.segment }} | {{ p.company.region }} | {{ p.company.employees }} employees | {{ p.company.revenue_band }}</p>

  <div class="card">
    <div class="score">{{ p.score }} <small>opportunity score, rank {{ p.rank }} of {{ p.of }}</small></div>
    <p>{{ n.summary }}</p>
  </div>

  <h2>Suggested angle</h2>
  <div class="card"><ul style="margin:0;padding-left:20px">{% for a in n.angle %}<li style="margin:4px 0">{{ a }}</li>{% endfor %}</ul></div>

  <h2>Stakeholders</h2>
  <div class="card"><table>
    <tr><th>Name</th><th>Title</th><th>Role in the deal</th></tr>
    {% for x in p.people %}<tr><td>{{ x.name }}</td><td>{{ x.title }}</td><td>{{ x.role_type.replace('_', ' ') }}</td></tr>
    {% endfor %}
  </table></div>

  <h2>Technology footprint</h2>
  <div class="card">
    {% for t in p.tech %}<p style="margin:4px 0">{{ t.name }} <span class="tag {{ t.generation }}">{{ t.generation }}</span> <code>{{ t.category }}, since {{ t.since[:4] }}</code></p>
    {% endfor %}
  </div>

  <h2>Score breakdown: every point is traceable</h2>
  <div class="card"><table>
    <tr><th>Contribution</th><th class="num">Weight</th><th class="num hide-sm">Conf.</th><th class="num hide-sm">Recency</th><th class="num">Points</th><th class="hide-sm">Evidence</th></tr>
    {% for c in p.contributions %}<tr>
      <td>{{ c.label.replace('_', ' ') }}: {{ c.summary }}</td><td class="num">{{ c.weight }}</td>
      <td class="num hide-sm">{{ c.confidence }}</td><td class="num hide-sm">{{ c.recency }}</td><td class="num">{{ c.points }}</td>
      <td class="hide-sm"><code>{{ (c.signal_id ~ ' / ' ~ c.source_id) if c.signal_id else 'graph structure' }}</code></td></tr>
    {% endfor %}
    <tfoot><tr><td>Total</td><td></td><td class="hide-sm"></td><td class="hide-sm"></td><td class="num">{{ p.score }}</td><td class="hide-sm"></td></tr></tfoot>
  </table></div>

  <h2>Discovery questions</h2>
  <div class="card"><ol style="margin:0;padding-left:20px">{% for q in n.questions %}<li>{{ q }}</li>{% endfor %}</ol></div>

  <h2>Evidence</h2>
  <div class="card"><table>
    <tr><th>Signal</th><th>Observed</th><th>Source</th><th class="hide-sm">Link</th></tr>
    {% for s in p.signals %}<tr><td>{{ s.signal_id }} {{ s.type }}</td><td>{{ s.observed_at }}</td><td><code>{{ s.source_type }} / {{ s.source_id }}</code></td><td class="hide-sm"><code>{{ s.evidence_url }}</code></td></tr>
    {% endfor %}
  </table></div>
</main>
</body>
</html>
